# MuxCore Module — Environment Variables
# Copy to .env and adjust for your environment.

# Core connection
# MUXCORE_GRPC_ADDR=localhost:9090
# MUXCORE_INSECURE_DISABLE_TLS=true

# Module identity
# MUXCORE_MODULE_ID=tracing-otlp

# Module-specific settings
# TRACING_GRPC_ADDR=127.0.0.1:9613
# MUXCORE_GRPC_INSECURE=true
# TRACING_TLS_CERT=
# TRACING_TLS_KEY=
# TRACING_TLS_CA=
# TRACING_TLS_DIR=

# OTLP export (when unset, completed spans are logged via slog)
# OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
# OTEL_EXPORTER_OTLP_INSECURE=true
