[Unit]
Description=MuxCore Module - tracing-otlp
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=muxcore
Group=muxcore
ExecStart=/usr/local/bin/tracing-otlp \
  --muxcore-mesh-addr localhost:9090 \
  --muxcore-module-id tracing-otlp
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

; Security hardening
CapabilityBoundingSet=
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tracing-otlp

[Install]
WantedBy=multi-user.target
